{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apac-reg-tracker",
  "main": "worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No custom domain (lawplain.com belonged to the upstream project) — this
  // deploys to the free *.workers.dev subdomain instead.
  "vars": {
    "BETTER_AUTH_URL": "https://apac-reg-tracker.markirrzo.workers.dev",
    "LAWPLAIN_ASK_AGENT_ENABLED": "true",
    "LAWPLAIN_PUBLIC_HOST": "apac-reg-tracker.markirrzo.workers.dev",
    "LAWPLAIN_AGENT_CREDENTIAL": "CODEGRAFF_API_KEY",
    "REG_TRACKER_API_URL": "https://apac-reg-tracker.onrender.com"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "apac-reg-tracker"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ASK_RUN_DO", "class_name": "AskRunDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AskRunDO"] }],
  "kv_namespaces": [
    { "binding": "STATS_KV", "id": "f66d532046814e2daba2bc0bd145a877" }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "apac-reg-tracker-auth",
      "database_id": "3abbd730-7341-4724-abd5-f4b9ad3c8b59",
      "migrations_dir": "migrations"
    }
  ]
}
